{
  "name": "dsh-pdf2md",
  "version": "0.1.0",
  "description": "DSH skill: convert PDF and Office documents to Markdown or plain text, preserving heading levels where the source allows it, and refusing scanned PDFs instead of writing empty output.",
  "type": "module",
  "main": "lib/startup.js",
  "exports": {
    ".": "./lib/startup.js",
    "./startup": "./lib/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-skill",
    "pdf",
    "markdown",
    "text-extraction",
    "pymupdf",
    "markitdown",
    "ocr",
    "document-conversion"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
